# FamVaya – Umgebungsvariablen
# Kopiere diese Datei nach .env.local und trage echte Werte ein.
# .env.local wird von .gitignore ignoriert und darf niemals committet werden.

# --- Supabase (Phase 0: Grundlage, ab Phase 1 aktiv genutzt) -----------------
# Projekt-URL und Keys aus: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-Role-Key: NIEMALS im Client-Code verwenden, nur serverseitig (z. B. Seed-Skripte, Admin-Routen).
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2+: noch nicht implementiert, hier nur vorbereitet ----------------

# E-Mail-Versand (Resend) – für Magic Link, Newsletter, Transaktions-Mails.
# Für den Newsletter-Versand aus dem Admin-Bereich (Phase 14) werden beide
# Werte benötigt, siehe README.md "Newsletter-Versand aktivieren". Ohne sie
# funktioniert das Erstellen von Kampagnen normal, nur der "Jetzt an alle
# Abonnent:innen senden"-Button bleibt deaktiviert.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Kartenanbieter (Mapbox oder Google Maps) – für Standort-/Kartenansichten
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Instagram (Graph API) – für Direkt-Posting aus dem Admin-Bereich
# (Phase 11), siehe README.md "Instagram-Anbindung aktivieren" und
# DECISIONS.md. Ohne diese Werte funktioniert der Post-Generator normal,
# nur der "Jetzt bei Instagram posten"-Button bleibt deaktiviert.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
